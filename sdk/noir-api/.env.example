# Port to listen on.
PORT=8787
# API keys, as written by `npm run keygen`. Either inline JSON or a path.
# Only SHA-256 hashes are stored here, never the keys themselves.
NOIR_API_KEYS_FILE=./keys.json
# NOIR_API_KEYS=[{"id":"…","name":"my-app","hash":"…","scopes":["read"]}]
# Requests per minute per key when the key doesn't set its own.
NOIR_API_RATE_LIMIT=120
# Comma-separated browser origins allowed to call the API (empty = none).
NOIR_API_CORS_ORIGINS=
# Where webhook subscriptions are kept between restarts.
NOIR_API_WEBHOOKS_FILE=./webhooks.json
# Allow http:// and localhost webhook URLs (local development only).
NOIR_API_ALLOW_INSECURE_WEBHOOKS=false
# Your own Noir deployment instead of Noir's Testnet contracts (all four or none).
# NOIR_RPC_URL=https://soroban-testnet.stellar.org
# NOIR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# NOIR_DEVICE_REGISTRY=C…
# NOIR_AGENT_REGISTRY=C…
# NOIR_PAYMENT_ESCROW=C…
