{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": { "@noirx402/agent-sdk": ["../sdk/agent-sdk/src/index.ts"] }
  },
  "include": ["src", "tests", "build.mjs", "vitest.config.ts"]
}
