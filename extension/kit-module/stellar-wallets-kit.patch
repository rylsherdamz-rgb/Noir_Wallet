diff --git a/src/sdk/modules/noir.module.test.ts b/src/sdk/modules/noir.module.test.ts
new file mode 100644
index 0000000..46eff19
--- /dev/null
+++ b/src/sdk/modules/noir.module.test.ts
@@ -0,0 +1,84 @@
+/// <reference lib="deno.ns" />
+import { assertEquals, assertRejects } from "jsr:@std/assert@1";
+import { Networks } from "../../types/mod.ts";
+import { NOIR_ID, NoirModule } from "./noir.module.ts";
+
+// deno-lint-ignore no-explicit-any
+const g = globalThis as any;
+
+function makeProvider() {
+  const calls: string[] = [];
+  return {
+    calls,
+    isNoir: true as const,
+    isConnected: () => Promise.resolve({ isConnected: true }),
+    isAllowed: () => Promise.resolve({ isAllowed: true }),
+    requestAccess: () => {
+      calls.push("requestAccess");
+      return Promise.resolve({ address: "GACCESS" });
+    },
+    getAddress: () => {
+      calls.push("getAddress");
+      return Promise.resolve({ address: "GADDRESS" });
+    },
+    getNetwork: () => Promise.resolve({ network: "TESTNET", networkPassphrase: Networks.TESTNET }),
+    signTransaction: (xdr: string, opts?: { networkPassphrase?: string; address?: string }) => {
+      calls.push(`signTransaction:${xdr}:${opts?.networkPassphrase}:${opts?.address}`);
+      return Promise.resolve({ signedTxXdr: "SIGNED", signerAddress: "GSIGNER" });
+    },
+    signAuthEntry: () => Promise.resolve({ signedAuthEntry: "AUTH_SIG", signerAddress: "GSIGNER" }),
+    signMessage: () => Promise.resolve({ signedMessage: "MSG_SIG", signerAddress: "GSIGNER" }),
+  };
+}
+
+function install(provider?: ReturnType<typeof makeProvider>): void {
+  g.window = provider ? { noir: { stellar: provider } } : {};
+}
+
+Deno.test("NoirModule exposes its id and is unavailable without the extension", async () => {
+  install();
+  const module = new NoirModule();
+  assertEquals(module.productId, NOIR_ID);
+  assertEquals(await module.isAvailable(), false);
+  await assertRejects(() => module.getAddress());
+  delete g.window;
+});
+
+Deno.test("NoirModule requests access unless told to skip it", async () => {
+  const provider = makeProvider();
+  install(provider);
+  const module = new NoirModule();
+  assertEquals(await module.isAvailable(), true);
+  assertEquals(await module.getAddress(), { address: "GACCESS" });
+  assertEquals(await module.getAddress({ skipRequestAccess: true }), { address: "GADDRESS" });
+  assertEquals(provider.calls, ["requestAccess", "getAddress"]);
+  delete g.window;
+});
+
+Deno.test("NoirModule passes SEP-43 options through and maps results", async () => {
+  const provider = makeProvider();
+  install(provider);
+  const module = new NoirModule();
+  const tx = await module.signTransaction("XDR", {
+    networkPassphrase: Networks.TESTNET,
+    address: "GSIGNER",
+    path: "x",
+  });
+  assertEquals(tx, { signedTxXdr: "SIGNED", signerAddress: "GSIGNER" });
+  assertEquals(provider.calls.at(-1), `signTransaction:XDR:${Networks.TESTNET}:GSIGNER`);
+  assertEquals(await module.signAuthEntry("ENTRY"), { signedAuthEntry: "AUTH_SIG", signerAddress: "GSIGNER" });
+  assertEquals(await module.signMessage("hi"), { signedMessage: "MSG_SIG", signerAddress: "GSIGNER" });
+  assertEquals(await module.getNetwork(), { network: "TESTNET", networkPassphrase: Networks.TESTNET });
+  delete g.window;
+});
+
+Deno.test("NoirModule throws the provider's error object", async () => {
+  const provider = makeProvider();
+  provider.signMessage = () =>
+    Promise.resolve({ error: { code: -4, message: "The user rejected this request." } }) as never;
+  install(provider);
+  const module = new NoirModule();
+  const err = await module.signMessage("hi").catch((e) => e);
+  assertEquals(err, { code: -4, message: "The user rejected this request.", ext: undefined });
+  delete g.window;
+});
diff --git a/src/sdk/modules/noir.module.ts b/src/sdk/modules/noir.module.ts
new file mode 100644
index 0000000..bd01c12
--- /dev/null
+++ b/src/sdk/modules/noir.module.ts
@@ -0,0 +1,128 @@
+/**
+ * Noir Wallet module for the Stellar Wallets Kit.
+ *
+ * Noir Wallet (https://rylsherdamz-rgb.github.io/Noir_Wallet/) is a browser
+ * extension that injects a SEP-43 provider at `window.noir.stellar`. Every
+ * provider method resolves (it never rejects) with the SEP-43 result or with
+ * `{ error: { code, message } }`; this module turns that error into a throw.
+ * Requests are approved by the user in the extension; the module needs no
+ * dependency and no polyfill.
+ */
+
+import { type ModuleInterface, ModuleType } from "../../types/mod.ts";
+
+export const NOIR_ID: string = "noir";
+
+interface NoirError {
+  code: number;
+  message: string;
+  ext?: string[];
+}
+
+type NoirResult<T> = T & { error?: NoirError };
+
+interface NoirSignOpts {
+  networkPassphrase?: string;
+  address?: string;
+}
+
+interface NoirProvider {
+  isNoir: true;
+  isConnected(): Promise<NoirResult<{ isConnected: boolean }>>;
+  isAllowed(): Promise<NoirResult<{ isAllowed: boolean }>>;
+  requestAccess(): Promise<NoirResult<{ address: string }>>;
+  getAddress(): Promise<NoirResult<{ address: string }>>;
+  getNetwork(): Promise<NoirResult<{ network: string; networkPassphrase: string }>>;
+  signTransaction(
+    xdr: string,
+    opts?: NoirSignOpts,
+  ): Promise<NoirResult<{ signedTxXdr: string; signerAddress: string }>>;
+  signAuthEntry(
+    authEntry: string,
+    opts?: NoirSignOpts,
+  ): Promise<NoirResult<{ signedAuthEntry: string; signerAddress: string }>>;
+  signMessage(
+    message: string,
+    opts?: NoirSignOpts,
+  ): Promise<NoirResult<{ signedMessage: string; signerAddress: string }>>;
+}
+
+declare const window: { noir?: { stellar?: NoirProvider } } | undefined;
+
+export class NoirModule implements ModuleInterface {
+  moduleType: ModuleType = ModuleType.HOT_WALLET;
+
+  productId: string = NOIR_ID;
+  productName: string = "Noir Wallet";
+  productUrl: string = "https://rylsherdamz-rgb.github.io/Noir_Wallet/";
+  productIcon: string = NOIR_ICON;
+
+  async isAvailable(): Promise<boolean> {
+    return typeof window !== "undefined" && window.noir?.stellar?.isNoir === true;
+  }
+
+  async getAddress(params?: { path?: string; skipRequestAccess?: boolean }): Promise<{ address: string }> {
+    const provider = await this.provider();
+    const { address } = unwrap(
+      params?.skipRequestAccess ? await provider.getAddress() : await provider.requestAccess(),
+    );
+    return { address };
+  }
+
+  async signTransaction(
+    xdr: string,
+    opts?: { networkPassphrase?: string; address?: string; path?: string },
+  ): Promise<{ signedTxXdr: string; signerAddress?: string }> {
+    const provider = await this.provider();
+    const { signedTxXdr, signerAddress } = unwrap(await provider.signTransaction(xdr, signOpts(opts)));
+    return { signedTxXdr, signerAddress };
+  }
+
+  async signAuthEntry(
+    authEntry: string,
+    opts?: { networkPassphrase?: string; address?: string; path?: string },
+  ): Promise<{ signedAuthEntry: string; signerAddress?: string }> {
+    const provider = await this.provider();
+    const { signedAuthEntry, signerAddress } = unwrap(await provider.signAuthEntry(authEntry, signOpts(opts)));
+    return { signedAuthEntry, signerAddress };
+  }
+
+  async signMessage(
+    message: string,
+    opts?: { networkPassphrase?: string; address?: string; path?: string },
+  ): Promise<{ signedMessage: string; signerAddress?: string }> {
+    const provider = await this.provider();
+    const { signedMessage, signerAddress } = unwrap(await provider.signMessage(message, signOpts(opts)));
+    return { signedMessage, signerAddress };
+  }
+
+  async getNetwork(): Promise<{ network: string; networkPassphrase: string }> {
+    const provider = await this.provider();
+    const { network, networkPassphrase } = unwrap(await provider.getNetwork());
+    return { network, networkPassphrase };
+  }
+
+  private async provider(): Promise<NoirProvider> {
+    if (!(await this.isAvailable())) {
+      throw { code: -1, message: "Noir Wallet is not installed" };
+    }
+    return window!.noir!.stellar!;
+  }
+}
+
+/** Only the SEP-43 options Noir reads; `path` is for hardware wallets. */
+function signOpts(opts?: { networkPassphrase?: string; address?: string }): NoirSignOpts | undefined {
+  if (!opts) return undefined;
+  const { networkPassphrase, address } = opts;
+  return { networkPassphrase, address };
+}
+
+function unwrap<T>(result: NoirResult<T>): T {
+  if (result?.error) {
+    throw { code: result.error.code, message: result.error.message, ext: result.error.ext?.join(", ") };
+  }
+  return result;
+}
+
+const NOIR_ICON =
+  "data:image/png;base64,";
