# ── Required ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://noir_user:noir_password@localhost:5432/noir_wallet

# ── Server ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=info
RUST_LOG=info,noir_backend=debug
REQUEST_TIMEOUT_SECS=30
MAX_REQUEST_BODY_BYTES=65536

# ── Database pool ───────────────────────────────────────────────────────────
DB_MAX_CONNECTIONS=20
DB_MIN_CONNECTIONS=2
DB_CONNECT_TIMEOUT_SECS=10
DB_IDLE_TIMEOUT_SECS=600

# ── Rate limiting ────────────────────────────────────────────────────────────
# Counted in Postgres, so the limit holds across every running instance.
RATE_LIMIT_WINDOW_SECS=60
RATE_LIMIT_MAX_REQUESTS=10

# ── Sessions ─────────────────────────────────────────────────────────────────
# A session token is issued after the caller signs a challenge nonce with the
# wallet key it claims to own. The challenge TTL is short by design.
SESSION_TTL_SECS=86400
CHALLENGE_TTL_SECS=300

# Optional coarse edge filter, compared in constant time. This is NOT the
# security model — wallet-signature sessions are. Leave empty to disable.
API_KEY=

# ── PDAX settlement ─────────────────────────────────────────────────────────
# PDAX_ENVIRONMENT selects which base URL below is used: uat | stage | production
# Stay on uat/stage until reviewed — never commit real keys here.
# Base URLs already include the /api/pdax-api prefix; the login client appends
# /pdax-institution/v1/login on top of that.
PDAX_ENVIRONMENT=uat
PDAX_API_BASE_URL_PRODUCTION=https://services.pdax.ph/api/pdax-api
PDAX_API_BASE_URL_STAGE=https://stage.services.sandbox.pdax.ph/api/pdax-api
PDAX_API_BASE_URL_UAT=https://uat.services.sandbox.pdax.ph/api/pdax-api
PDAX_USERNAME=
PDAX_PASSWORD=
PDAX_API_KEY=
PDAX_API_SECRET=

# Required in production — startup fails without it. Every settlement webhook
# is rejected when it is empty, which would leave orders stuck at 'ordered'.
PDAX_WEBHOOK_SECRET=

# Session cache — written automatically by `cargo run --example pdax_login`
# and refreshed by `cargo run --example pdax_refresh_token`. Leave blank.
PDAX_ACCESS_TOKEN=
PDAX_REFRESH_TOKEN=
PDAX_TOKEN_EXPIRES_AT=

# ── Removed ─────────────────────────────────────────────────────────────────
# STELLAR_NETWORK, STELLAR_RPC_URL, STELLAR_HORIZON_URL — the backend no longer
#   talks to Stellar; the payment path is on-chain.
# CHANNEL_SECRET_KEY, MASTER_KEY_ID — the backend holds no keys and custodies
#   no wallets.
# CHANNEL_MIN_BALANCE_STROOPS, CHANNEL_TOPUP_TARGET_STROOPS — no fee channels.
# *_INTERVAL_SECS worker knobs — all five background workers are gone.
